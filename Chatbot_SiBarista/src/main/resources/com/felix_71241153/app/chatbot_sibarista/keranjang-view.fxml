<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.KeranjangController"
        style="-fx-background-color: #F0E6D3;"
        prefWidth="520" prefHeight="700">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TOP : Header                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <top>
        <VBox style="-fx-background-color: #1C0A00;">
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #1C0A00;">
                <padding><Insets top="14" right="20" bottom="14" left="16"/></padding>

                <!-- Tombol Kembali -->
                <Button fx:id="backButton" onAction="#handleBack" text="← Kembali"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #C8A882;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-border-color: #C8A882;
                               -fx-border-radius: 6;
                               -fx-border-width: 1;
                               -fx-background-radius: 6;
                               -fx-padding: 6 14 6 14;"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Judul -->
                <Label text="🛒  Keranjang"
                       style="-fx-text-fill: #FBF7F0;
                              -fx-font-size: 20px;
                              -fx-font-weight: bold;"/>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- ── Filter Kategori ── -->
            <HBox spacing="8" alignment="CENTER_LEFT"
                  style="-fx-background-color: #3D1A00;">
                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>

                <Button text="☕ Semua"    onAction="#handleFilterSemua"
                        style="-fx-background-color: #C8A882; -fx-text-fill: #1C0A00;
                               -fx-font-size: 12px; -fx-cursor: hand;
                               -fx-background-radius: 20; -fx-padding: 5 14 5 14;
                               -fx-font-weight: bold;"/>
                <Button text="Kopi"       onAction="#handleFilterKopi"
                        style="-fx-background-color: transparent; -fx-text-fill: #C8A882;
                               -fx-font-size: 12px; -fx-cursor: hand;
                               -fx-border-color: #C8A882; -fx-border-radius: 20;
                               -fx-border-width: 1; -fx-background-radius: 20;
                               -fx-padding: 5 14 5 14;"/>
                <Button text="Non-Kopi"   onAction="#handleFilterNonKopi"
                        style="-fx-background-color: transparent; -fx-text-fill: #C8A882;
                               -fx-font-size: 12px; -fx-cursor: hand;
                               -fx-border-color: #C8A882; -fx-border-radius: 20;
                               -fx-border-width: 1; -fx-background-radius: 20;
                               -fx-padding: 5 14 5 14;"/>
                <Button text="Snack"    onAction="#handleFilterMakanan"
                        style="-fx-background-color: transparent; -fx-text-fill: #C8A882;
                               -fx-font-size: 12px; -fx-cursor: hand;
                               -fx-border-color: #C8A882; -fx-border-radius: 20;
                               -fx-border-width: 1; -fx-background-radius: 20;
                               -fx-padding: 5 14 5 14;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  CENTER : Daftar Menu (kiri) + Keranjang (kanan)                   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <center>
        <HBox spacing="0">

            <!-- ── Panel Kiri : Daftar Menu ── -->
            <VBox prefWidth="300" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #F0E6D3;">

                <!-- Sub-header -->
                <HBox alignment="CENTER_LEFT">
                    <padding><Insets top="14" right="12" bottom="6" left="16"/></padding>
                    <Label fx:id="sectionTitle" text="Semua Menu"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #3D1A00;"/>
                </HBox>

                <!-- Daftar produk dari DB -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="menuListContainer" spacing="0">
                        <padding><Insets top="4" right="12" bottom="12" left="12"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ── Divider vertikal ── -->
            <Separator orientation="VERTICAL"
                       style="-fx-background-color: #C8A882;"/>

            <!-- ── Panel Kanan : Keranjang ── -->
            <VBox prefWidth="220" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #FBF7F0;">

                <!-- Sub-header -->
                <HBox alignment="CENTER_LEFT">
                    <padding><Insets top="14" right="12" bottom="6" left="16"/></padding>
                    <Label text="🛒  Pesanan Saya"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #3D1A00;"/>
                </HBox>

                <!-- Item keranjang -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="cartItemContainer" spacing="0">
                        <padding><Insets top="4" right="10" bottom="12" left="10"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  BOTTOM : Total Harga + Tombol Checkout                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <bottom>
        <VBox style="-fx-background-color: #1C0A00;">
            <Separator style="-fx-background-color: #C8A882;"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>

                <VBox spacing="2">
                    <Label text="Total Harga"
                           style="-fx-text-fill: #C8A882;
                                  -fx-font-size: 11px;
                                  -fx-font-style: italic;"/>
                    <Label fx:id="totalLabel" text="Rp 0"
                           style="-fx-text-fill: #FBF7F0;
                                  -fx-font-size: 18px;
                                  -fx-font-weight: bold;"/>
                </VBox>

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Tombol Checkout -->
                <Button text="Checkout  →"
                        onAction="#handleCheckout"
                        style="-fx-background-color: #C8A882;
                               -fx-text-fill: #1C0A00;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-background-radius: 8;
                               -fx-padding: 10 24 10 24;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
